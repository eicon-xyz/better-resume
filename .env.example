# better-resume 开发环境变量样例（真实密钥一律走环境变量，禁止入库）
# 用法：cp .env.example .env   （compose 与本地 uv run 都读仓库根 .env）

# ---- API settings（pydantic-settings 前缀 BR_）----
BR_ENVIRONMENT=local
BR_LOG_LEVEL=INFO
BR_DATABASE_URL=postgresql+asyncpg://better_resume:better_resume@localhost:5432/better_resume
BR_REDIS_URL=redis://localhost:6379/0
BR_SESSION_COOKIE_NAME=br_session
BR_SESSION_TTL_SECONDS=2592000
BR_SESSION_COOKIE_SECURE=false
BR_REQUEST_ID_HEADER=X-Request-Id
# ---- compose（docker compose 变量替换；api 容器内会覆盖 host 为服务名）----
POSTGRES_USER=better_resume
POSTGRES_PASSWORD=better_resume
POSTGRES_DB=better_resume
POSTGRES_PORT=5432
API_PORT=8000
