# better-resume 开发环境变量样例（真实密钥一律走环境变量，禁止入库）
# 用法：cp .env.example .env   （compose 与本地 uv run 都读仓库根 .env）

# ---- API settings（pydantic-settings 前缀 BR_）----
BR_ENVIRONMENT=local
BR_LOG_LEVEL=INFO
BR_DATABASE_URL=postgresql+asyncpg://better_resume:better_resume@localhost:5432/better_resume
BR_REDIS_URL=redis://localhost:6379/0
BR_SESSION_COOKIE_NAME=br_session
BR_SESSION_TTL_SECONDS=2592000
BR_SESSION_COOKIE_SECURE=false
BR_REQUEST_ID_HEADER=X-Request-Id
BR_SSE_HEARTBEAT_SECONDS=15
BR_RESUME_STORAGE_DIR=data/resumes
# ---- P5：Redis 自动 failover（Sentinel）----
# 两个都留空 = 走上面的 BR_REDIS_URL 单 URL，行为与今天一致（本地/CI 默认）。
# 演练（哨兵服务在 compose 的 drill profile 里，普通 up 不会启）：
#   BR_REDIS_SENTINELS=redis://redis-sentinel-1:26379,redis://redis-sentinel-2:26379,redis://redis-sentinel-3:26379 \
#   BR_REDIS_MASTER_NAME=br-master docker compose --profile drill up -d
# BR_REDIS_SENTINELS=
# BR_REDIS_MASTER_NAME=

# ---- P7：限流状态放 Redis（多副本共享一份对外配额）+ 降级语义（D19）----
# backend=memory（默认，本地/CI）时每个副本一份配额；compose 里默认改成 redis。
# Redis 不可用时不 fail-closed：退回进程内桶，并在响应头标 X-RateLimit-Scope: instance。
# BR_RATE_LIMIT__BACKEND=memory|redis
# BR_RATE_LIMIT__SHARED_BUCKETS=ai_call,answer,heavy
# BR_RATE_LIMIT__REDIS_SOCKET_TIMEOUT_MS=50
# BR_RATE_LIMIT__DEGRADED_COOLDOWN_SECONDS=30

# ---- compose（docker compose 变量替换；api 容器内会覆盖 host 为服务名）----
POSTGRES_USER=better_resume
POSTGRES_PASSWORD=better_resume
POSTGRES_DB=better_resume
POSTGRES_PORT=5432
NGINX_PORT=8080
# ---- 语音/LLM 供应商（真实凭据只进 gitignored .env；这里只列变量名）----
# BR_DASHSCOPE_API_KEY=
# BR_DASHSCOPE_APP_ID=            # P3：Model Studio 应用调用（场景绑定里 target_ref = app_id）
# BR_DASHSCOPE_APP_BASE_URL=      # 可选，默认 https://dashscope.aliyuncs.com
# BR_MEDIA__TRANSCRIPTION_ADAPTER=scripted|xunfei|qwen-asr|paraformer-rt
# BR_MEDIA__ASR_URL=
# BR_MEDIA__ASR_MODEL=qwen-audio-3.0-asr-flash
# BR_MEDIA__ASR_WS_URL=
# BR_MEDIA__ASR_REALTIME_MODEL=paraformer-realtime-v2

# ---- 受限网络：镜像站前缀（默认留空 = 上游原始 tag）----
# BR_LIBRARY_PREFIX=docker.m.daocloud.io/library/
# BR_UV_IMAGE=ghcr.m.daocloud.io/astral-sh/uv:latest
# 本机手工构建时关掉 buildx bake（P45：bake 路径不授予 network.host，而 compose.yaml 请求了它）；
# 演练脚本已各自 export，无需手动
# COMPOSE_BAKE=false

# ---- 部署冒烟用（scripts/compose_smoke.sh 会自己设置，正常部署留空）----
# BR_SMOKE_KEY=smoke-fake-key
